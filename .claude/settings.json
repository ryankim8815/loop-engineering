{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Agent",
      "TodoWrite",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx biome *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm src/*)",
      "Bash(rm tests/*)",
      "Bash(rm public/*)",
      "Bash(rm -r src/*)",
      "Bash(rm -r tests/*)",
      "Bash(rm -r public/*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(sudo *)",
      "Bash(npm publish *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./specs/**)",
      "Edit(./PROMPT_*.md)",
      "Edit(./loop.sh)",
      "Edit(./scripts/**)",
      "Edit(./.claude/**)",
      "Write(./specs/**)",
      "Write(./PROMPT_*.md)",
      "Write(./loop.sh)",
      "Write(./scripts/**)",
      "Write(./.claude/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
